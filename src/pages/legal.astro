---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Legal"
  description="The legal notes of NXAevora: affiliation, game files, the license and the credits of this website."
>
  <section class="panel" aria-labelledby="legal-title">
    <h1 class="page-title" id="legal-title">Legal</h1>
    <p class="page-lede">The rules for the use of NXAevora and the credits of this website.</p>
  </section>

  <section class="panel legal-panel" aria-labelledby="affiliation-title">
    <h2 id="affiliation-title">Not affiliated</h2>
    <div class="legal-prose">
      <p>NXAevora is an independent project. It is not affiliated with or endorsed by Nintendo, The Pokemon Company or Game Freak. Pokemon and Pokemon Legends Arceus are trademarks of their owners.</p>
    </div>
  </section>

  <section class="panel legal-panel" aria-labelledby="files-title">
    <h2 id="files-title">Game files</h2>
    <div class="legal-prose">
      <p>You must own the game to use NXAevora. The files that you make with it, such as the recompiled code, come from the game and are for your own use. Do not distribute them.</p>
      <p>NXAevora contains no game files. Do not ask for them and do not share them.</p>
    </div>
  </section>

  <section class="panel legal-panel" aria-labelledby="license-title">
    <h2 id="license-title">License of NXAevora</h2>
    <div class="legal-prose">
      <p>NXAevora is free software under the GNU General Public License, version 3 or later. ScarletNX is also GPL-3.0.</p>
    </div>
    <div class="legal-links">
      <a class="inline-link" href="https://github.com/nxaevora/nxaevora-main/blob/main/LICENSE">LICENSE</a>
      <a class="inline-link" href="https://github.com/nxaevora/nxaevora-main/blob/main/docs/CREDITS.md">credits of NXAevora</a>
    </div>
  </section>

  <section class="panel legal-panel" aria-labelledby="credits-title">
    <h2 id="credits-title">Credits of this website</h2>
    <p class="legal-prose">This website uses these projects.</p>
    <div class="credit-table-scroll" role="region" aria-label="Credits of this website" tabindex="0">
      <table class="credit-table">
        <caption class="visually-hidden">Credits of this website</caption>
        <thead>
          <tr>
            <th scope="col">Project</th>
            <th scope="col">Use</th>
            <th scope="col">License</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><a class="inline-link" href="https://astro.build/">Astro</a></td>
            <td>Site framework</td>
            <td>MIT</td>
          </tr>
          <tr>
            <td><a class="inline-link" href="https://github.com/material-components/material-web">Material Web (Google LLC)</a></td>
            <td>Buttons, chips and icon buttons</td>
            <td>Apache 2.0</td>
          </tr>
          <tr>
            <td><a class="inline-link" href="https://github.com/material-foundation/material-color-utilities">material-color-utilities (Google LLC)</a></td>
            <td>The color scheme from the seed color</td>
            <td>Apache 2.0</td>
          </tr>
          <tr>
            <td><a class="inline-link" href="https://github.com/googlefonts/roboto-3-classic">Roboto (The Roboto Project Authors)</a></td>
            <td>Text font</td>
            <td>SIL OFL 1.1</td>
          </tr>
          <tr>
            <td><a class="inline-link" href="https://github.com/google/material-design-icons">Material Symbols (Google LLC)</a></td>
            <td>Icons</td>
            <td>Apache 2.0 (the Fontsource package of the font is SIL OFL 1.1)</td>
          </tr>
          <tr>
            <td><a class="inline-link" href="https://github.com/withastro/astro/tree/main/packages/integrations/sitemap">@astrojs/sitemap</a></td>
            <td>Sitemap of the site at the build</td>
            <td>MIT</td>
          </tr>
          <tr>
            <td><a class="inline-link" href="https://github.com/withastro/astro/tree/main/packages/astro-rss">@astrojs/rss</a></td>
            <td>RSS feed</td>
            <td>MIT</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-prose {
    max-width: 70ch;
    margin-top: 16px;
  }

  .legal-prose p + p {
    margin-top: 16px;
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 16px;
  }

  .credit-table-scroll {
    max-width: 100%;
    min-width: 0;
    margin-top: 16px;
    overflow-x: auto;
  }

  .credit-table-scroll:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 3px;
  }

  .credit-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    text-align: left;
  }

  .credit-table th {
    padding: 0 24px 12px 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-title-small-size);
    line-height: var(--md-sys-typescale-title-small-line-height);
    font-weight: 500;
    white-space: nowrap;
  }

  .credit-table td {
    padding: 16px 24px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
    vertical-align: top;
  }

  .credit-table th:first-child,
  .credit-table td:first-child {
    padding-left: 0;
  }

  .credit-table th:last-child,
  .credit-table td:last-child {
    padding-right: 0;
    white-space: nowrap;
  }
</style>
