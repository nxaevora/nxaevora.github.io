---
const links = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features/' },
  { label: 'Download', href: '/download/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Community', href: '/community/' },
  { label: 'Legal', href: '/legal/' },
];

const pathname = Astro.url.pathname;
const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
const current = normalized === '/' ? '/' : normalized.startsWith('/blog/') ? '/blog/' : normalized;
---

<header class="site-header">
  <div class="column header-inner">
    <a class="brand" href="/" aria-label="NXAevora home">
      <img class="brand-logo" src="/images/nxaevora-logo.svg" alt="" width="1000" height="310" />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <span class="nav-indicator" aria-hidden="true"></span>
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="icon-link" href="https://github.com/nxaevora" aria-label="NXAevora on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
      </a>
      <md-icon-button class="menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="material-symbols-rounded menu-icon" slot="icon" aria-hidden="true">menu</span>
      </md-icon-button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav class="column" aria-label="Main menu">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector('.menu-button');
  const menuIcon = menuButton?.querySelector('.menu-icon');
  const mobileNav = document.getElementById('mobile-nav');

  if (menuButton && mobileNav) {
    const setMenu = (open: boolean): void => {
      mobileNav.hidden = !open;
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (menuIcon) menuIcon.textContent = open ? 'close' : 'menu';
    };

    menuButton.addEventListener('click', () => setMenu(Boolean(mobileNav.hidden)));
    mobileNav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileNav.hidden) {
        setMenu(false);
        (menuButton as HTMLElement).focus();
      }
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 1000 && !mobileNav.hidden) setMenu(false);
    });
  }

  const header = document.querySelector('.site-header');
  const setHeaderScrolled = (): void => {
    header?.classList.toggle('is-scrolled', window.scrollY > 0);
  };
  setHeaderScrolled();
  window.addEventListener('scroll', setHeaderScrolled, { passive: true });
</script>
